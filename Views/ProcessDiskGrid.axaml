<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ResMonNext.ViewModels"
             x:Class="ResMonNext.Views.ProcessDiskGrid"
             x:DataType="vm:ProcessTable">
  <DataGrid x:Name="Grid" ItemsSource="{Binding Items}">
    <DataGrid.Columns>
      <DataGridTemplateColumn Header="" Width="40" SortMemberPath="Checked" CanUserResize="False">
        <DataGridTemplateColumn.CellTemplate>
          <DataTemplate x:DataType="vm:ProcessRow">
            <CheckBox Classes="row" IsChecked="{Binding IsChecked}" ToolTip.Tip="Filtrer sur ce processus" />
          </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
      <DataGridTextColumn x:DataType="vm:ProcessRow" Header="Image" Binding="{Binding Name}" SortMemberPath="Name" Width="1.6*" MinWidth="120" />
      <DataGridTextColumn x:DataType="vm:ProcessRow" Header="PID" Binding="{Binding Pid}" SortMemberPath="Pid" Width="0.7*" MinWidth="86" CellStyleClasses="num" />
      <DataGridTextColumn x:DataType="vm:ProcessRow" Header="Description" Binding="{Binding Description}" SortMemberPath="Description" Width="2*" MinWidth="120" />
      <DataGridTextColumn x:DataType="vm:ProcessRow" Header="Lecture (o/s)" Binding="{Binding IoRead, StringFormat={}{0:N0}}" SortMemberPath="IoRead" Width="1*" MinWidth="124" CellStyleClasses="num" />
      <DataGridTextColumn x:DataType="vm:ProcessRow" Header="Écriture (o/s)" Binding="{Binding IoWrite, StringFormat={}{0:N0}}" SortMemberPath="IoWrite" Width="1*" MinWidth="124" CellStyleClasses="num" />
      <DataGridTextColumn x:DataType="vm:ProcessRow" Header="Total (o/s)" Binding="{Binding IoTotal, StringFormat={}{0:N0}}" SortMemberPath="IoTotal" Width="1*" MinWidth="124" CellStyleClasses="num" />
    </DataGrid.Columns>
  </DataGrid>
</UserControl>

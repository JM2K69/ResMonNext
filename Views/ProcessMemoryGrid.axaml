<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ResMonNext.ViewModels"
             x:Class="ResMonNext.Views.ProcessMemoryGrid"
             x:DataType="vm:ProcessTable">
  <DataGrid x:Name="Grid" ItemsSource="{Binding Items}">
    <DataGrid.Columns>
      <DataGridTemplateColumn Header="" Width="40" SortMemberPath="Checked" CanUserResize="False">
        <DataGridTemplateColumn.CellTemplate>
          <DataTemplate x:DataType="vm:ProcessRow">
            <CheckBox Classes="row" IsChecked="{Binding IsChecked}" ToolTip.Tip="Filtrer sur ce processus" />
          </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
      <DataGridTextColumn x:DataType="vm:ProcessRow" Header="Image" Binding="{Binding Name}" SortMemberPath="Name" Width="1.6*" MinWidth="120" />
      <DataGridTextColumn x:DataType="vm:ProcessRow" Header="PID" Binding="{Binding Pid}" SortMemberPath="Pid" Width="0.7*" MinWidth="86" CellStyleClasses="num" />
      <DataGridTextColumn x:DataType="vm:ProcessRow" Header="Défauts matériels/s" Binding="{Binding HardFaults, StringFormat={}{0:0}}" SortMemberPath="HardFaults" Width="1.1*" MinWidth="120" CellStyleClasses="num" />
      <DataGridTextColumn x:DataType="vm:ProcessRow" Header="Validation (Ko)" Binding="{Binding CommitKb, StringFormat={}{0:N0}}" SortMemberPath="Commit" Width="1*" MinWidth="110" CellStyleClasses="num" />
      <DataGridTextColumn x:DataType="vm:ProcessRow" Header="Plage de travail (Ko)" Binding="{Binding WorkingSetKb, StringFormat={}{0:N0}}" SortMemberPath="WorkingSet" Width="1.1*" MinWidth="120" CellStyleClasses="num" />
      <DataGridTextColumn x:DataType="vm:ProcessRow" Header="Partageable (Ko)" Binding="{Binding ShareableKb, StringFormat={}{0:N0}}" SortMemberPath="Shareable" Width="1*" MinWidth="110" CellStyleClasses="num" />
      <DataGridTextColumn x:DataType="vm:ProcessRow" Header="Privée (Ko)" Binding="{Binding PrivateKb, StringFormat={}{0:N0}}" SortMemberPath="Private" Width="1*" MinWidth="100" CellStyleClasses="num" />
    </DataGrid.Columns>
  </DataGrid>
</UserControl>
